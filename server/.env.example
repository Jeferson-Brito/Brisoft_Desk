# ==========================================================================
# BRISOFT DESK - CONFIGURAÇÕES DO SERVIDOR
# ==========================================================================

PORT=3000
NODE_ENV=development

# Segurança (use valores longos e exclusivos em produção)
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h
BOOTSTRAP_ADMIN_EMAIL=admin@empresa.com
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha-temporaria
ALLOWED_ORIGINS=http://localhost:3000

# Conexão Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anonima-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui
SUPABASE_MEDIA_BUCKET=chat-media
SUPABASE_SESSION_BUCKET=whatsapp-sessions
CLOUD_STORAGE_ENABLED=true

# WhatsApp Settings
WHATSAPP_SESSION_NAME=brisoft-desk-session
WHATSAPP_AUTO_RECONNECT=true
WHATSAPP_MESSAGE_CONCURRENCY=10
WHATSAPP_MAX_PENDING_MESSAGES=10000
WHATSAPP_RETRY_CACHE_HOURS=24
WHATSAPP_MAX_MEDIA_MB=25
WHATSAPP_MEDIA_RETENTION_DAYS=30
WHATSAPP_MEDIA_CLEANUP_HOURS=6
